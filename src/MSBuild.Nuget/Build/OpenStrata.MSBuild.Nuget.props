<Project >

	<PropertyGroup>
		<NugetExePath Condition="'$(NugetExePath)' == ''">$(MSBuildThisFileDirectory)..\tools\nuget.exe</NugetExePath>
		<SingleSpacePathSuffixFix>%20</SingleSpacePathSuffixFix>
	</PropertyGroup>

	<PropertyGroup>
		<DelayCreationOfNugetPackage Condition="'$(DelayCreationOfNugetPackage)' == ''">true</DelayCreationOfNugetPackage>

		<GenerateNuspecDependsOn>
			GetPackageMetadataFromFiles;
			_CheckForDelayedPackageCreation;
			$(GenerateNuspecDependsOn)
		</GenerateNuspecDependsOn>

		<DelayedPackageCreationDependsOn>
			AddNoTargetProjectReferencesToNuspec;
			$(DelayedPackageCreationDependsOn)
		</DelayedPackageCreationDependsOn>

		<AddPackageReferencesRequiredForInstall Condition="'$(AddPackageReferencesRequiredForInstall)' == ''">true</AddPackageReferencesRequiredForInstall>
	</PropertyGroup>

	<PropertyGroup>
		<DefaultLogoPath>$(MSBuildThisFileDirectory)..\media\DefaultIcon.png</DefaultLogoPath>
	</PropertyGroup>



</Project>
